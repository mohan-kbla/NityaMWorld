<div class="container py-5">
  <h2 class="fw-bold mb-4">Your Shopping Cart</h2>

  <% if @cart_items.any? %>
    <div class="row g-4">
      <!-- Left Column: Items List -->
      <div class="col-lg-8">
        <div class="card border-0 shadow-sm p-4 mb-4">
          <div class="table-responsive">
            <table class="table align-middle">
              <thead>
                <tr class="text-muted small text-uppercase">
                  <th>Product</th>
                  <th>Quantity</th>
                  <th>Price</th>
                  <th class="text-end">Total</th>
                  <th></th>
                </tr>
              </thead>
              <tbody>
                <% @cart_items.each do |item| %>
                  <% product = item[:product] %>
                  <tr>
                    <td>
                      <div class="d-flex align-items-center gap-3">
                        <div class="rounded bg-light text-center p-2" style="width: 60px; height: 60px; display: flex; align-items: center; justify-content: center;">
                          <i class="fa-solid fa-image text-muted"></i>
                        </div>
                        <div>
                          <h6 class="fw-bold m-0"><a href="/shop/<%= product.slug %>" class="text-dark text-decoration-none"><%= product.name %></a></h6>
                          <small class="text-muted"><%= product.brand.name %></small>
                        </div>
                      </div>
                    </td>
                    <td>
                      <!-- Form to update quantity -->
                      <%= form_with url: cart_path, method: :patch, class: "d-flex align-items-center gap-2" do |f| %>
                        <%= hidden_field_tag :product_id, product.id %>
                        <%= f.number_field :quantity, value: item[:quantity], min: 0, max: product.stock, class: "form-control form-control-sm", style: "width: 70px;" %>
                        <%= f.submit "Update", class: "btn btn-outline-dark btn-sm rounded-pill" %>
                      <% end %>
                    </td>
                    <td>
                      ₹<%= number_with_precision(product.active_price, precision: 2) %>
                    </td>
                    <td class="text-end fw-bold">
                      ₹<%= number_with_precision(product.active_price * item[:quantity], precision: 2) %>
                    </td>
                    <td class="text-end">
                      <%= button_to cart_path(product_id: product.id), method: :delete, class: "btn btn-light btn-sm text-danger border-0" do %>
                        <i class="fa-solid fa-trash"></i>
                      <% end %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>

          <div class="d-flex justify-content-between mt-3">
            <a href="/shop" class="btn btn-outline-secondary rounded-pill px-4"><i class="fa-solid fa-chevron-left me-2"></i>Continue Shopping</a>
            <%= button_to cart_path, method: :delete, data: { confirm: "Clear entire cart?" }, class: "btn btn-outline-danger rounded-pill px-4" do %>
              <i class="fa-solid fa-trash me-2"></i>Clear Cart
            <% end %>
          </div>
        </div>

        <!-- Coupon Card -->
        <div class="card border-0 shadow-sm p-4">
          <h5 class="fw-bold mb-3">Apply Promo Code</h5>
          <%= form_with url: apply_coupon_cart_path, method: :post, class: "row g-2 align-items-center" do |f| %>
            <div class="col-md-8">
              <%= f.text_field :coupon_code, class: "form-control", placeholder: "Enter code (e.g. SAVE20)", required: true %>
            </div>
            <div class="col-md-4">
              <%= f.submit "Apply Coupon", class: "btn btn-dark w-100 rounded-pill" %>
            </div>
          <% end %>

          <% if @coupon_code.present? %>
            <div class="alert alert-success mt-3 d-flex justify-content-between align-items-center mb-0">
              <span>Coupon <strong><%= @coupon_code %></strong> applied!</span>
              <%= button_to "Remove", remove_coupon_cart_path, method: :post, class: "btn btn-sm btn-outline-danger border-0" %>
            </div>
          <% end %>
        </div>
      </div>

      <!-- Right Column: Order Summary -->
      <div class="col-lg-4">
        <div class="card border-0 shadow-sm p-4">
          <h4 class="fw-bold mb-4">Order Summary</h4>
          <hr class="mt-0">
          <table class="table table-borderless table-sm small">
            <tr>
              <td class="text-muted">Subtotal:</td>
              <td class="text-end">₹<%= number_with_precision(@subtotal, precision: 2) %></td>
            </tr>
            <% if @discount > 0 %>
              <tr class="text-danger">
                <td>Discount:</td>
                <td class="text-end">-₹<%= number_with_precision(@discount, precision: 2) %></td>
              </tr>
            <% end %>
            <tr>
              <td class="text-muted">Shipping:</td>
              <td class="text-end">
                <% if @shipping_fee > 0 %>
                  ₹<%= number_with_precision(@shipping_fee, precision: 2) %>
                <% else %>
                  <span class="text-success fw-bold">FREE</span>
                <% end %>
              </td>
            </tr>
            <tr class="border-top font-weight-bold fs-5">
              <td class="pt-3">Grand Total:</td>
              <td class="text-end pt-3">₹<%= number_with_precision(@total, precision: 2) %></td>
            </tr>
          </table>
          <a href="/checkout/new" class="btn btn-accent btn-lg w-100 rounded-pill mt-4">Proceed to Checkout</a>
          <small class="text-muted text-center d-block mt-3">Free shipping on orders above ₹1000</small>
        </div>
      </div>
    </div>
  <% else %>
    <!-- Empty Cart state -->
    <div class="text-center py-5 bg-white rounded shadow-sm border border-light">
      <i class="fa-solid fa-cart-shopping fa-4x text-muted mb-3"></i>
      <h3>Your cart is empty</h3>
      <p class="text-muted">Looks like you haven't added any products to your cart yet.</p>
      <a href="/shop" class="btn btn-accent rounded-pill px-4 mt-3">Start Shopping</a>
    </div>
  <% end %>
</div>
