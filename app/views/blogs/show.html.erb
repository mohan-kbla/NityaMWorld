<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-lg-9">
      <div class="mb-4">
        <a href="/blogs" class="btn btn-link text-dark p-0 text-decoration-none"><i class="fa-solid fa-chevron-left me-2"></i>Back to Blog</a>
      </div>

      <div class="bg-white p-5 rounded shadow-sm border border-light">
        <small class="text-muted"><%= @blog.published_at.strftime("%B %d, %Y") %></small>
        <h1 class="fw-bold my-3"><%= @blog.title %></h1>
        <hr class="my-4">
        <div class="blog-content text-muted" style="white-space: pre-wrap; line-height: 1.8;">
          <%= @blog.content %>
        </div>
      </div>
    </div>
  </div>
</div>
