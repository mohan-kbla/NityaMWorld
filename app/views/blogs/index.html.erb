<div class="container py-5">
  <div class="text-center mb-5">
    <h1 class="fw-bold">Our Store Blog</h1>
    <p class="text-muted">Stay updated with the latest news, healthy recipes, and tips from NityaMWorld.</p>
  </div>

  <div class="row g-4">
    <% if @blogs.any? %>
      <% @blogs.each do |blog| %>
        <div class="col-md-6 col-lg-4">
          <div class="card card-premium h-100 p-3 d-flex flex-column justify-content-between">
            <div>
              <div class="mb-3 text-center" style="height: 180px; background-color: #f1f5f9; display: flex; align-items: center; justify-content: center; border-radius: 8px;">
                <i class="fa-solid fa-pen-nib fa-3x text-secondary"></i>
              </div>
              <small class="text-muted"><%= blog.published_at.strftime("%B %d, %Y") %></small>
              <h5 class="fw-bold mt-2 mb-3"><%= blog.title %></h5>
              <p class="text-muted small"><%= truncate(blog.content, length: 120) %></p>
            </div>
            <div class="mt-3">
              <a href="/blogs/<%= blog.slug %>" class="btn btn-outline-dark btn-sm rounded-pill px-3">Read Article</a>
            </div>
          </div>
        </div>
      <% end %>
    <% else %>
      <div class="col-12 text-center py-5">
        <p class="text-muted">No blog posts published yet.</p>
      </div>
    <% end %>
  </div>

  <div class="mt-4">
    <%= paginate @blogs %>
  </div>
</div>
