<!DOCTYPE html>
<html lang="en">
  <head>
    <title>NityaMWorld - Admin Panel</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    
    <!-- Google Fonts (Inter) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    
    <!-- FontAwesome for Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" integrity="sha512-SnH5WK+bZxgPHs44uWIX+LLJAJ9/2PkPKZ5QiAj6Ta86w+fsb2TkcmfRyVX3pBnMFcV7oQPJkl9QevSCWr3W6A==" crossorigin="anonymous" referrerpolicy="no-referrer" />

    <style>
      body {
        font-family: 'Inter', sans-serif;
        background-color: #f8f9fa;
        color: #212529;
      }
      
      .sidebar {
        min-height: 100vh;
        background: #1e1e2d;
        color: #a2a3b7;
      }

      .sidebar a {
        color: #a2a3b7;
        text-decoration: none;
        display: block;
        padding: 12px 24px;
        transition: all 0.2s ease;
      }

      .sidebar a:hover, .sidebar a.active {
        color: #ffffff;
        background: #1b1b28;
        border-left: 4px solid #0d6efd;
      }

      .sidebar .brand {
        padding: 24px;
        font-size: 1.25rem;
        font-weight: 700;
        color: #ffffff;
        border-bottom: 1px solid #2c2c3e;
      }

      .admin-content {
        padding: 30px;
      }

      .navbar-admin {
        background: #ffffff;
        border-bottom: 1px solid #e4e6ef;
        padding: 16px 30px;
      }

      .card-stat {
        border: none;
        border-radius: 12px;
        box-shadow: 0 0 20px rgba(0, 0, 0, 0.05);
        transition: transform 0.2s ease;
      }

      .card-stat:hover {
        transform: translateY(-5px);
      }
    </style>
  </head>

  <body>
    <div class="container-fluid p-0">
      <div class="row g-0">
        <!-- Sidebar -->
        <div class="col-md-3 col-lg-2 sidebar">
          <div class="brand">
            <i class="fa-solid fa-cart-shopping me-2"></i>NityaMWorld
          </div>
          <div class="py-3">
            <a href="/admin" class="<%= 'active' if controller_name == 'dashboard' %>">
              <i class="fa-solid fa-chart-line me-2"></i>Dashboard
            </a>
            <a href="/admin/products" class="<%= 'active' if controller_name == 'products' %>">
              <i class="fa-solid fa-box me-2"></i>Products
            </a>
            <a href="/admin/categories" class="<%= 'active' if controller_name == 'categories' %>">
              <i class="fa-solid fa-list-ul me-2"></i>Categories
            </a>
            <a href="/admin/brands" class="<%= 'active' if controller_name == 'brands' %>">
              <i class="fa-solid fa-tag me-2"></i>Brands
            </a>
            <a href="/admin/orders" class="<%= 'active' if controller_name == 'orders' %>">
              <i class="fa-solid fa-receipt me-2"></i>Orders
            </a>
            <a href="/admin/customers" class="<%= 'active' if controller_name == 'customers' %>">
              <i class="fa-solid fa-users me-2"></i>Customers
            </a>
            <a href="/admin/coupons" class="<%= 'active' if controller_name == 'coupons' %>">
              <i class="fa-solid fa-ticket me-2"></i>Coupons
            </a>
            <a href="/admin/banners" class="<%= 'active' if controller_name == 'banners' %>">
              <i class="fa-solid fa-image me-2"></i>Banners
            </a>
            <a href="/admin/testimonials" class="<%= 'active' if controller_name == 'testimonials' %>">
              <i class="fa-solid fa-comment-dots me-2"></i>Testimonials
            </a>
            <a href="/admin/blogs" class="<%= 'active' if controller_name == 'blogs' %>">
              <i class="fa-solid fa-pen-nib me-2"></i>Blog
            </a>
            <a href="/admin/pages" class="<%= 'active' if controller_name == 'pages' %>">
              <i class="fa-solid fa-file-lines me-2"></i>Pages
            </a>
            <a href="/admin/reviews" class="<%= 'active' if controller_name == 'reviews' %>">
              <i class="fa-solid fa-star me-2"></i>Reviews
            </a>
            <a href="/admin/users" class="<%= 'active' if controller_name == 'users' %>">
              <i class="fa-solid fa-user-shield me-2"></i>Users & Roles
            </a>
          </div>
        </div>

        <!-- Main Body -->
        <div class="col-md-9 col-lg-10">
          <!-- Top Header -->
          <div class="navbar-admin d-flex justify-content-between align-items-center">
            <h5 class="m-0 font-weight-bold">Admin Panel</h5>
            <div class="dropdown">
              <button class="btn btn-light dropdown-toggle" type="button" data-bs-toggle="dropdown">
                <i class="fa-solid fa-user-circle me-1"></i><%= current_user&.first_name || 'Admin' %>
              </button>
              <ul class="dropdown-menu dropdown-menu-end">
                <li>
                  <%= button_to destroy_user_session_path, method: :delete, class: "dropdown-item text-danger" do %>
                    <i class="fa-solid fa-right-from-bracket me-2"></i>Log Out
                  <% end %>
                </li>
              </ul>
            </div>
          </div>

          <!-- Alert Messages -->
          <% if flash[:notice] %>
            <div class="alert alert-success alert-dismissible fade show m-3" role="alert">
              <%= flash[:notice] %>
              <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
          <% end %>
          <% if flash[:alert] %>
            <div class="alert alert-danger alert-dismissible fade show m-3" role="alert">
              <%= flash[:alert] %>
              <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
          <% end %>

          <!-- Content Body -->
          <div class="admin-content">
            <%= yield %>
          </div>
        </div>
      </div>
    </div>

    <!-- Bootstrap 5 JavaScript Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
  </body>
</html>
