<!DOCTYPE html>
<html lang="en">
  <head>
    <title>NityaMWorld - E-commerce Store</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <!-- Google Fonts (Inter) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">

    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" integrity="sha512-SnH5WK+bZxgPHs44uWIX+LLJAJ9/2PkPKZ5QiAj6Ta86w+fsb2TkcmfRyVX3pBnMFcV7oQPJkl9QevSCWr3W6A==" crossorigin="anonymous" referrerpolicy="no-referrer" />

    <style>
      body {
        font-family: 'Inter', sans-serif;
        background-color: #f8fafc;
        color: #0f172a;
      }

      .navbar-storefront {
        background-color: #ffffff;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
        padding: 16px 0;
      }

      .btn-accent {
        background-color: #f59e0b;
        color: #ffffff;
        border: none;
        transition: background 0.2s ease;
      }

      .btn-accent:hover {
        background-color: #d97706;
        color: #ffffff;
      }

      .footer-storefront {
        background-color: #0f172a;
        color: #94a3b8;
        padding: 60px 0 30px;
        margin-top: 80px;
      }

      .footer-storefront a {
        color: #cbd5e1;
        text-decoration: none;
        transition: color 0.2s ease;
      }

      .footer-storefront a:hover {
        color: #f59e0b;
      }

      .card-premium {
        border: none;
        border-radius: 12px;
        background: #ffffff;
        box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.05);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
      }

      .card-premium:hover {
        transform: translateY(-5px);
        box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1);
      }
    </style>
  </head>

  <body>
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-storefront sticky-top">
      <div class="container">
        <a class="navbar-brand fw-bold text-primary fs-3 d-flex align-items-center" href="/">
          <i class="fa-solid fa-store me-2 text-warning"></i>NityaMWorld
        </a>
        
        <button class="navbar-brand navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
          <i class="fa-solid fa-bars"></i>
        </button>

        <div class="collapse navbar-collapse" id="navbarContent">
          <!-- Categories dropdown -->
          <ul class="navbar-nav me-auto mb-2 mb-lg-0">
            <li class="nav-item">
              <a class="nav-link fw-medium" href="/shop">Shop</a>
            </li>
            <li class="nav-item dropdown">
              <a class="nav-link dropdown-toggle fw-medium" href="#" role="button" data-bs-toggle="dropdown">
                Categories
              </a>
              <ul class="dropdown-menu">
                <% if @store_categories&.any? %>
                  <% @store_categories.each do |cat| %>
                    <li><a class="dropdown-item" href="/shop?q[category_id_eq]=<%= cat.id %>"><%= cat.name %></a></li>
                  <% end %>
                <% else %>
                  <li><a class="dropdown-item disabled" href="#">No categories</a></li>
                <% end %>
              </ul>
            </li>
            <li class="nav-item">
              <a class="nav-link fw-medium" href="/blogs">Blog</a>
            </li>
          </ul>

          <!-- Search form -->
          <form class="d-flex me-lg-4 mb-3 mb-lg-0 w-100" style="max-width: 320px;" action="/shop" method="get">
            <div class="input-group">
              <input class="form-control border-end-0 rounded-start-pill" type="search" name="q[name_cont]" placeholder="Search products..." required>
              <button class="btn btn-outline-secondary border-start-0 rounded-end-pill" type="submit">
                <i class="fa-solid fa-magnifying-glass text-muted"></i>
              </button>
            </div>
          </form>

          <!-- User & Cart utility -->
          <div class="d-flex align-items-center gap-3">
            <a href="/cart" class="btn btn-outline-dark position-relative rounded-pill px-3">
              <i class="fa-solid fa-shopping-cart me-2"></i>Cart
              <% if @cart_item_count > 0 %>
                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                  <%= @cart_item_count %>
                </span>
              <% end %>
            </a>

            <% if user_signed_in? %>
              <div class="dropdown">
                <button class="btn btn-dark dropdown-toggle rounded-pill px-3" type="button" data-bs-toggle="dropdown">
                  <i class="fa-solid fa-user me-1"></i><%= current_user.first_name %>
                </button>
                <ul class="dropdown-menu dropdown-menu-end">
                  <% if current_user.admin? || current_user.staff? %>
                    <li><a class="dropdown-item" href="/admin"><i class="fa-solid fa-chart-line me-2"></i>Admin Dashboard</a></li>
                  <% end %>
                  <li><a class="dropdown-item" href="/wishlists"><i class="fa-solid fa-heart me-2"></i>My Wishlist</a></li>
                  <li>
                    <%= button_to destroy_user_session_path, method: :delete, class: "dropdown-item text-danger" do %>
                      <i class="fa-solid fa-right-from-bracket me-2"></i>Log Out
                    <% end %>
                  </li>
                </ul>
              </div>
            <% else %>
              <a href="/users/sign_in" class="btn btn-dark rounded-pill px-3">Log In</a>
            <% end %>
          </div>
        </div>
      </div>
    </nav>

    <!-- Flash Notifications -->
    <div class="container my-3">
      <% if flash[:notice] %>
        <div class="alert alert-success alert-dismissible fade show" role="alert">
          <%= flash[:notice] %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% end %>
      <% if flash[:alert] %>
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
          <%= flash[:alert] %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% end %>
    </div>

    <!-- Main Content Yield -->
    <main class="min-vh-100">
      <%= yield %>
    </main>

    <!-- Footer -->
    <footer class="footer-storefront">
      <div class="container">
        <div class="row g-4 mb-5">
          <div class="col-lg-4 col-md-6">
            <h5 class="text-white fw-bold mb-3">NityaMWorld</h5>
            <p>Your premium destination for exquisite handcrafted heritage jewellery and 100% natural wood-pressed oils. Crafted with purity and delivered with care.</p>
            <div class="d-flex gap-3 fs-5 mt-3">
              <a href="#"><i class="fa-brands fa-facebook"></i></a>
              <a href="#"><i class="fa-brands fa-instagram"></i></a>
              <a href="#"><i class="fa-brands fa-twitter"></i></a>
            </div>
          </div>
          <div class="col-lg-2 col-md-3">
            <h6 class="text-white text-uppercase fw-bold mb-3 small">Quick Links</h6>
            <ul class="list-unstyled">
              <li><a href="/shop" class="d-block mb-2">Shop Catalog</a></li>
              <li><a href="/blogs" class="d-block mb-2">Our Blog</a></li>
              <li><a href="/wishlists" class="d-block mb-2">Wishlist</a></li>
            </ul>
          </div>
          <div class="col-lg-2 col-md-3">
            <h6 class="text-white text-uppercase fw-bold mb-3 small">Information Policy</h6>
            <ul class="list-unstyled">
              <li><a href="/p/privacy-policy" class="d-block mb-2">Privacy Policy</a></li>
              <li><a href="/p/terms-conditions" class="d-block mb-2">Terms & Conditions</a></li>
              <li><a href="/p/shipping-returns" class="d-block mb-2">Shipping & Returns</a></li>
            </ul>
          </div>
          <div class="col-lg-4 col-md-6">
            <h6 class="text-white text-uppercase fw-bold mb-3 small">Contact Us</h6>
            <p class="mb-2"><i class="fa-solid fa-location-dot me-2 text-warning"></i>NityaMWorld HQ, Karnataka, India</p>
            <p class="mb-2"><i class="fa-solid fa-envelope me-2 text-warning"></i>support@nityamworld.com</p>
            <p class="mb-0"><i class="fa-solid fa-phone me-2 text-warning"></i>+91 98765 43210</p>
          </div>
        </div>
        <hr class="border-secondary">
        <div class="d-flex justify-content-between flex-wrap pt-3 small text-secondary">
          <p class="mb-0">&copy; <%= Time.current.year %> NityaMWorld. All rights reserved.</p>
          <p class="mb-0">Designed with excellence by Antigravity</p>
        </div>
      </div>
    </footer>

    <!-- Bootstrap 5 JavaScript Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>

    <!-- Hotwire/Turbo Carousel Auto-slide Initialization -->
    <script>
      (function() {
        function initCarousels() {
          if (typeof bootstrap === 'undefined') return;
          var carousels = document.querySelectorAll('.carousel');
          carousels.forEach(function(carousel) {
            try {
              var instance = bootstrap.Carousel.getOrCreateInstance(carousel, {
                interval: 4000,
                wrap: true
              });
              instance.cycle();
            } catch(e) {
              console.error("Carousel initialization error:", e);
            }
          });
        }

        document.addEventListener("turbo:load", initCarousels);
        document.addEventListener("DOMContentLoaded", initCarousels);
      })();
    </script>
  </body>
</html>
