<div class="d-flex justify-content-between align-items-center mb-4">
  <h2 class="m-0">Banners</h2>
  <a href="/admin/banners/new" class="btn btn-primary"><i class="fa-solid fa-plus me-2"></i>Add Banner</a>
</div>

<div class="card border-0 shadow-sm p-4">
  <div class="table-responsive">
    <table class="table table-hover align-middle">
      <thead class="table-light">
        <tr>
          <th>Title</th>
          <th>Subtitle</th>
          <th>Link URL</th>
          <th>Position</th>
          <th>Status</th>
          <th class="text-end">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if @banners.any? %>
          <% @banners.each do |banner| %>
            <tr>
              <td><strong><%= banner.title %></strong></td>
              <td><%= banner.subtitle %></td>
              <td><code><%= banner.link_url %></code></td>
              <td><%= banner.position %></td>
              <td>
                <span class="badge bg-<%= banner.active ? 'success' : 'danger' %>">
                  <%= banner.active ? "Active" : "Inactive" %>
                </span>
              </td>
              <td class="text-end">
                <div class="btn-group">
                  <a href="/admin/banners/<%= banner.id %>/edit" class="btn btn-light btn-sm text-primary"><i class="fa-solid fa-pen"></i></a>
                  <%= button_to admin_banner_path(banner), method: :delete, data: { confirm: "Are you sure?" }, class: "btn btn-light btn-sm text-danger" do %>
                    <i class="fa-solid fa-trash"></i>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        <% else %>
          <tr>
            <td colspan="6" class="text-center text-muted py-3">No banners configured.</td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  
  <div class="mt-3">
    <%= paginate @banners %>
  </div>
</div>
