<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h2 class="h3 fw-bold text-dark m-0">
      <i class="fa-solid fa-boxes-packing text-primary me-2"></i>Orders Management
    </h2>
    <p class="text-muted small m-0 mt-1">View, filter, and manage customer orders and fulfillment statuses.</p>
  </div>
</div>

<!-- Search & Filters -->
<div class="card border-0 shadow-sm p-3 p-md-4 mb-4 rounded-3 bg-white">
  <%= search_form_for [:admin, @q], class: "row g-3 align-items-end" do |f| %>
    <div class="col-12 col-md-3">
      <%= f.label :id_eq, "Order ID", class: "form-label small fw-semibold text-secondary text-nowrap mb-1" %>
      <%= f.search_field :id_eq, class: "form-control", placeholder: "Order ID..." %>
    </div>
    
    <div class="col-12 col-md-3">
      <%= f.label :status_eq, "Order Status", class: "form-label small fw-semibold text-secondary text-nowrap mb-1" %>
      <%= f.select :status_eq, [["Pending", "pending"], ["Confirmed", "confirmed"], ["Packed", "packed"], ["Shipped", "shipped"], ["Delivered", "delivered"], ["Cancelled", "cancelled"], ["Refunded", "refunded"]], { include_blank: "All Statuses" }, { class: "form-select" } %>
    </div>

    <div class="col-12 col-md-3">
      <%= f.label :payment_status_eq, "Payment Status", class: "form-label small fw-semibold text-secondary text-nowrap mb-1" %>
      <%= f.select :payment_status_eq, [["Pending", "pending"], ["Paid", "paid"], ["Failed", "failed"], ["Refunded", "refunded"]], { include_blank: "All Payment Statuses" }, { class: "form-select" } %>
    </div>

    <div class="col-12 col-md-3 d-flex gap-2">
      <button type="submit" class="btn btn-primary text-nowrap flex-fill">
        <i class="fa-solid fa-filter me-1"></i> Filter
      </button>
      <a href="/admin/orders" class="btn btn-outline-secondary text-nowrap flex-fill">
        <i class="fa-solid fa-rotate-left me-1"></i> Reset
      </a>
    </div>
  <% end %>
</div>

<!-- Orders Table -->
<div class="card border-0 shadow-sm rounded-3 overflow-hidden bg-white mb-4">
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead class="bg-light border-bottom">
        <tr>
          <th class="ps-4 text-secondary text-uppercase fs-7 fw-bold" style="letter-spacing: 0.5px;">Order ID</th>
          <th class="text-secondary text-uppercase fs-7 fw-bold" style="letter-spacing: 0.5px;">Customer</th>
          <th class="text-end text-secondary text-uppercase fs-7 fw-bold" style="letter-spacing: 0.5px;">Total</th>
          <th class="text-center text-secondary text-uppercase fs-7 fw-bold" style="letter-spacing: 0.5px;">Payment</th>
          <th class="text-center text-secondary text-uppercase fs-7 fw-bold" style="letter-spacing: 0.5px;">Status</th>
          <th class="text-secondary text-uppercase fs-7 fw-bold" style="letter-spacing: 0.5px;">Date</th>
          <th class="pe-4 text-end text-secondary text-uppercase fs-7 fw-bold" style="letter-spacing: 0.5px;">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if @orders.any? %>
          <% @orders.each do |order| %>
            <tr>
              <td class="ps-4">
                <span class="fw-bold text-dark">#<%= order.id %></span>
              </td>
              <td>
                <div class="d-flex flex-column">
                  <% if order.user %>
                    <span class="fw-semibold text-dark"><%= "#{order.user.first_name} #{order.user.last_name}".strip.presence || order.user.email %></span>
                    <small class="text-muted"><%= order.user.email %></small>
                  <% else %>
                    <span class="fw-semibold text-dark">Guest Checkout</span>
                  <% end %>
                </div>
              </td>
              <td class="text-end fw-bold text-dark">
                ₹<%= number_with_precision(order.total_amount, precision: 2) %>
              </td>
              <td class="text-center">
                <% payment_badge_class = case order.payment_status
                  when 'paid' then 'bg-success text-white'
                  when 'pending' then 'bg-warning text-dark'
                  else 'bg-danger text-white' end %>
                <span class="badge <%= payment_badge_class %> px-2.5 py-1.5 rounded-pill text-uppercase fw-semibold" style="font-size: 11px;">
                  <%= order.payment_status.presence || 'PENDING' %>
                </span>
                <small class="text-muted d-block text-uppercase mt-0.5" style="font-size: 11px;"><%= order.payment_method %></small>
              </td>
              <td class="text-center">
                <% status_badge_style = nil %>
                <% status_badge_class = case order.status
                  when 'delivered' then 'bg-success text-white'
                  when 'pending' then 'bg-warning text-dark'
                  when 'confirmed', 'packed' then 'bg-primary text-white'
                  when 'shipped' then 'text-white'
                  when 'cancelled', 'refunded' then 'bg-danger text-white'
                  else 'bg-secondary text-white' end %>
                <% if order.status == 'shipped' %>
                  <% status_badge_style = "background-color: #8b5cf6; color: #ffffff;" %>
                <% end %>
                <span class="badge <%= status_badge_class %> px-2.5 py-1.5 rounded-pill text-capitalize fw-semibold" style="font-size: 11px; <%= status_badge_style %>">
                  <%= order.status %>
                </span>
              </td>
              <td class="text-muted small">
                <%= order.created_at.strftime("%b %d, %Y %H:%M") %>
              </td>
              <td class="pe-4 text-end">
                <a href="/admin/orders/<%= order.id %>" class="btn btn-sm btn-outline-primary rounded-pill px-3 fw-medium text-nowrap">
                  <i class="fa-solid fa-gear me-1"></i>Manage
                </a>
              </td>
            </tr>
          <% end %>
        <% else %>
          <tr>
            <td colspan="7" class="text-center text-muted py-5">
              <i class="fa-solid fa-box-open fa-2x d-block mb-2 text-secondary opacity-50"></i>
              No orders found matching your filter criteria.
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  
  <% if @orders.respond_to?(:total_pages) %>
    <div class="px-4 py-3 border-top bg-light d-flex justify-content-between align-items-center flex-wrap gap-2">
      <div class="small text-muted">
        Showing <strong><%= @orders.offset_value + 1 %></strong> - <strong><%= [@orders.offset_value + @orders.length, @orders.total_count].min %></strong> of <strong><%= @orders.total_count %></strong> orders
      </div>
      <div>
        <%= paginate @orders %>
      </div>
    </div>
  <% end %>
</div>
