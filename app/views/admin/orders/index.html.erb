<div class="d-flex justify-content-between align-items-center mb-4">
  <h2 class="m-0">Orders</h2>
</div>

<!-- Search & Filters -->
<div class="card border-0 shadow-sm p-4 mb-4">
  <%= search_form_for [:admin, @q], class: "row g-3 align-items-end" do |f| %>
    <div class="col-md-3">
      <%= f.label :id_eq, "Order ID", class: "form-label small text-muted" %>
      <%= f.search_field :id_eq, class: "form-control", placeholder: "Order ID..." %>
    </div>
    <div class="col-md-3">
      <%= f.label :status_eq, "Order Status", class: "form-label small text-muted" %>
      <%= f.select :status_eq, [["Pending", "pending"], ["Confirmed", "confirmed"], ["Packed", "packed"], ["Shipped", "shipped"], ["Delivered", "delivered"], ["Cancelled", "cancelled"], ["Refunded", "refunded"]], { include_blank: "All Statuses" }, { class: "form-select" } %>
    end
    <div class="col-md-3">
      <%= f.label :payment_status_eq, "Payment Status", class: "form-label small text-muted" %>
      <%= f.select :payment_status_eq, [["Pending", "pending"], ["Paid", "paid"], ["Failed", "failed"], ["Refunded", "refunded"]], { include_blank: "All Payment Statuses" }, { class: "form-select" } %>
    </div>
    <div class="col-md-3 d-flex gap-2">
      <%= f.submit "Filter", class: "btn btn-secondary w-100" %>
      <a href="/admin/orders" class="btn btn-outline-secondary w-100">Reset</a>
    </div>
  <% end %>
</div>

<!-- Orders Table -->
<div class="card border-0 shadow-sm p-4">
  <div class="table-responsive">
    <table class="table table-hover align-middle">
      <thead class="table-light">
        <tr>
          <th>Order ID</th>
          <th>Customer</th>
          <th>Total</th>
          <th>Payment</th>
          <th>Status</th>
          <th>Date</th>
          <th class="text-end">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if @orders.any? %>
          <% @orders.each do |order| %>
            <tr>
              <td><strong>#<%= order.id %></strong></td>
              <td><%= order.user&.email || "Guest Checkout" %></td>
              <td>₹<%= number_with_precision(order.total_amount, precision: 2) %></td>
              <td>
                <span class="badge bg-<%= case order.payment_status
                  when 'paid' then 'success'
                  when 'pending' then 'warning'
                  else 'danger' end %>">
                  <%= order.payment_status.upcase %>
                </span>
                <small class="text-muted d-block text-uppercase"><%= order.payment_method %></small>
              </td>
              <td>
                <span class="badge bg-<%= case order.status
                  when 'delivered' then 'success'
                  when 'pending' then 'warning'
                  when 'cancelled', 'refunded' then 'danger'
                  else 'info' end %> text-capitalize">
                  <%= order.status %>
                </span>
              </td>
              <td><%= order.created_at.strftime("%b %d, %Y %H:%M") %></td>
              <td class="text-end">
                <a href="/admin/orders/<%= order.id %>" class="btn btn-light btn-sm text-primary">Manage</a>
              </td>
            </tr>
          <% end %>
        <% else %>
          <tr>
            <td colspan="7" class="text-center text-muted py-3">No orders found.</td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  
  <div class="mt-3">
    <%= paginate @orders %>
  </div>
</div>
