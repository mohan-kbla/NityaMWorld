<%= form_with model: [:admin, product], local: true, class: "row g-3" do |f| %>
  <% if product.errors.any? %>
    <div class="col-12 alert alert-danger">
      <h6 class="alert-heading font-weight-bold"><%= pluralize(product.errors.count, "error") %> prohibited this product from being saved:</h6>
      <ul class="mb-0 small">
        <% product.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="col-md-6">
    <%= f.label :name, class: "form-label" %>
    <%= f.text_field :name, class: "form-control", required: true %>
  </div>

  <div class="col-md-6">
    <%= f.label :sku, "SKU", class: "form-label" %>
    <%= f.text_field :sku, class: "form-control", required: true %>
  </div>

  <div class="col-md-6">
    <%= f.label :category_id, "Category", class: "form-label" %>
    <%= f.collection_select :category_id, Category.all, :id, :name, { prompt: "Select Category" }, { class: "form-select", required: true } %>
  </div>

  <div class="col-md-6">
    <%= f.label :brand_id, "Brand", class: "form-label" %>
    <%= f.collection_select :brand_id, Brand.all, :id, :name, { prompt: "Select Brand" }, { class: "form-select", required: true } %>
  </div>

  <div class="col-md-3">
    <%= f.label :price, "Regular Price (₹)", class: "form-label" %>
    <%= f.number_field :price, step: "0.01", class: "form-control", required: true %>
  </div>

  <div class="col-md-3">
    <%= f.label :discount_price, "Discount Price (₹)", class: "form-label" %>
    <%= f.number_field :discount_price, step: "0.01", class: "form-control" %>
  </div>

  <div class="col-md-3">
    <%= f.label :stock, class: "form-label" %>
    <%= f.number_field :stock, class: "form-control", required: true %>
  </div>

  <div class="col-md-3">
    <%= f.label :weight, "Weight (kg)", class: "form-label" %>
    <%= f.number_field :weight, step: "0.01", class: "form-control" %>
  </div>

  <div class="col-12">
    <%= f.label :short_description, class: "form-label" %>
    <%= f.text_area :short_description, rows: 2, class: "form-control" %>
  </div>

  <div class="col-12">
    <%= f.label :description, class: "form-label" %>
    <%= f.text_area :description, rows: 5, class: "form-control" %>
  </div>

  <div class="col-12">
    <%= f.label :images, "Product Images", class: "form-label" %>
    <%= f.file_field :images, multiple: true, class: "form-control" %>
    <small class="text-muted">You can upload multiple files at once.</small>
  </div>

  <div class="col-12 d-flex gap-4 my-3">
    <div class="form-check">
      <%= f.check_box :featured, class: "form-check-input" %>
      <%= f.label :featured, class: "form-check-label" %>
    </div>
    <div class="form-check">
      <%= f.check_box :best_seller, class: "form-check-input" %>
      <%= f.label :best_seller, class: "form-check-label" %>
    </div>
    <div class="form-check">
      <%= f.check_box :new_arrival, class: "form-check-input" %>
      <%= f.label :new_arrival, class: "form-check-label" %>
    </div>
  </div>

  <hr>
  <h5>SEO Options</h5>

  <div class="col-md-6">
    <%= f.label :meta_title, class: "form-label" %>
    <%= f.text_field :meta_title, class: "form-control" %>
  </div>

  <div class="col-md-6">
    <%= f.label :meta_description, class: "form-label" %>
    <%= f.text_area :meta_description, rows: 2, class: "form-control" %>
  </div>

  <div class="col-12 mt-4 d-flex gap-2">
    <%= f.submit class: "btn btn-primary" %>
    <a href="/admin/products" class="btn btn-outline-secondary">Cancel</a>
  </div>
<% end %>
