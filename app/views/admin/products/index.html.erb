<div class="d-flex justify-content-between align-items-center mb-4">
  <h2 class="m-0">Products</h2>
  <a href="/admin/products/new" class="btn btn-primary"><i class="fa-solid fa-plus me-2"></i>Add Product</a>
</div>

<!-- Search & Filters -->
<div class="card border-0 shadow-sm p-4 mb-4">
  <%= search_form_for [:admin, @q], class: "row g-3 align-items-end" do |f| %>
    <div class="col-md-4">
      <%= f.label :name_cont, "Product Name", class: "form-label small text-muted" %>
      <%= f.search_field :name_cont, class: "form-control", placeholder: "Search name..." %>
    </div>
    <div class="col-md-2">
      <%= f.label :sku_eq, "SKU", class: "form-label small text-muted" %>
      <%= f.search_field :sku_eq, class: "form-control", placeholder: "SKU..." %>
    </div>
    <div class="col-md-2">
      <%= f.label :category_id_eq, "Category", class: "form-label small text-muted" %>
      <%= f.collection_select :category_id_eq, Category.all, :id, :name, { include_blank: "All Categories" }, { class: "form-select" } %>
    </div>
    <div class="col-md-2">
      <%= f.label :brand_id_eq, "Brand", class: "form-label small text-muted" %>
      <%= f.collection_select :brand_id_eq, Brand.all, :id, :name, { include_blank: "All Brands" }, { class: "form-select" } %>
    </div>
    <div class="col-md-2 d-flex gap-2">
      <%= f.submit "Filter", class: "btn btn-secondary w-100" %>
      <a href="/admin/products" class="btn btn-outline-secondary w-100">Reset</a>
    </div>
  <% end %>
</div>

<!-- Products Table -->
<div class="card border-0 shadow-sm p-4">
  <div class="table-responsive">
    <table class="table table-hover align-middle">
      <thead class="table-light">
        <tr>
          <th>SKU</th>
          <th>Name</th>
          <th>Category</th>
          <th>Brand</th>
          <th>Price</th>
          <th>Stock</th>
          <th>Featured</th>
          <th class="text-end">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if @products.any? %>
          <% @products.each do |product| %>
            <tr>
              <td><strong><%= product.sku %></strong></td>
              <td><%= product.name %></td>
              <td><%= product.category.name %></td>
              <td><%= product.brand.name %></td>
              <td>
                <% if product.discounted? %>
                  <span class="text-decoration-line-through text-muted small">₹<%= product.price %></span>
                  <span class="text-danger font-weight-bold">₹<%= product.discount_price %></span>
                <% else %>
                  ₹<%= product.price %>
                <% end %>
              </td>
              <td>
                <span class="badge bg-<%= product.stock > 5 ? 'success' : 'danger' %>">
                  <%= product.stock %>
                </span>
              </td>
              <td>
                <% if product.featured? %>
                  <span class="badge bg-primary">Featured</span>
                <% end %>
                <% if product.best_seller? %>
                  <span class="badge bg-info">Best Seller</span>
                <% end %>
              </td>
              <td class="text-end">
                <div class="btn-group">
                  <a href="/admin/products/<%= product.slug %>" class="btn btn-light btn-sm"><i class="fa-solid fa-eye"></i></a>
                  <a href="/admin/products/<%= product.slug %>/edit" class="btn btn-light btn-sm text-primary"><i class="fa-solid fa-pen"></i></a>
                  <% if policy(product).destroy? %>
                    <%= button_to admin_product_path(product), method: :delete, data: { confirm: "Are you sure?" }, class: "btn btn-light btn-sm text-danger" do %>
                      <i class="fa-solid fa-trash"></i>
                    <% end %>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        <% else %>
          <tr>
            <td colspan="8" class="text-center text-muted py-3">No products match your criteria.</td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  
  <div class="mt-3">
    <%= paginate @products %>
  </div>
</div>
