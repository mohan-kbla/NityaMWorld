<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h2 class="h3 fw-bold text-dark m-0">Customer Profile</h2>
    <p class="text-muted small m-0 mt-1">Detailed customer overview, saved addresses, and order history.</p>
  </div>
  <a href="/admin/customers" class="btn btn-outline-secondary rounded-pill px-4">
    <i class="fa-solid fa-arrow-left me-1"></i> Back to Customers
  </a>
</div>

<div class="row g-4 mb-4">
  <!-- Profile Summary Card -->
  <div class="col-12 col-lg-4">
    <div class="card border-0 shadow-sm p-4 rounded-3 bg-white h-100">
      <div class="text-center mb-4">
        <div class="rounded-circle bg-primary bg-opacity-10 text-primary fw-bold mx-auto d-flex align-items-center justify-content-center mb-3" style="width: 72px; height: 72px; font-size: 28px;">
          <%= @customer.first_name.first.upcase rescue 'C' %><%= @customer.last_name.first.upcase rescue '' %>
        </div>
        <h4 class="fw-bold text-dark m-0"><%= "#{@customer.first_name} #{@customer.last_name}".strip %></h4>
        <span class="badge bg-primary bg-opacity-10 text-primary mt-2 px-3 py-1.5 rounded-pill text-uppercase" style="font-size: 11px;">
          <%= @customer.role %>
        </span>
      </div>

      <hr class="text-secondary opacity-25">

      <div class="d-flex flex-column gap-3 fs-6">
        <div>
          <small class="text-muted d-block text-uppercase fw-semibold" style="font-size: 11px;">Email Address</small>
          <span class="fw-medium text-dark"><%= @customer.email %></span>
        </div>
        <div>
          <small class="text-muted d-block text-uppercase fw-semibold" style="font-size: 11px;">Phone Number</small>
          <span class="fw-medium text-dark"><%= @customer.phone.presence || "Not provided" %></span>
        </div>
        <div>
          <small class="text-muted d-block text-uppercase fw-semibold" style="font-size: 11px;">Member Since</small>
          <span class="fw-medium text-dark"><%= @customer.created_at.strftime("%B %d, %Y") %></span>
        </div>
      </div>
    </div>
  </div>

  <!-- Customer Order History -->
  <div class="col-12 col-lg-8">
    <div class="card border-0 shadow-sm rounded-3 overflow-hidden bg-white h-100">
      <div class="p-4 border-bottom bg-light d-flex justify-content-between align-items-center">
        <h5 class="fw-bold text-dark m-0">Order History (<%= @customer.orders.count %>)</h5>
      </div>

      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="bg-light">
            <tr>
              <th class="ps-4 text-secondary text-uppercase fs-7 fw-bold">Order ID</th>
              <th class="text-end text-secondary text-uppercase fs-7 fw-bold">Total</th>
              <th class="text-center text-secondary text-uppercase fs-7 fw-bold">Payment</th>
              <th class="text-center text-secondary text-uppercase fs-7 fw-bold">Status</th>
              <th class="text-secondary text-uppercase fs-7 fw-bold">Date</th>
              <th class="pe-4 text-end text-secondary text-uppercase fs-7 fw-bold">Action</th>
            </tr>
          </thead>
          <tbody>
            <% if @orders.any? %>
              <% @orders.each do |order| %>
                <tr>
                  <td class="ps-4 fw-bold">#<%= order.id %></td>
                  <td class="text-end fw-bold">₹<%= number_with_precision(order.total_amount, precision: 2) %></td>
                  <td class="text-center">
                    <span class="badge bg-<%= order.payment_status == 'paid' ? 'success' : 'warning' %> text-capitalize">
                      <%= order.payment_status %>
                    </span>
                  </td>
                  <td class="text-center">
                    <span class="badge bg-<%= order.status == 'delivered' ? 'success' : 'info' %> text-capitalize">
                      <%= order.status %>
                    </span>
                  </td>
                  <td class="text-muted small"><%= order.created_at.strftime("%b %d, %Y") %></td>
                  <td class="pe-4 text-end">
                    <a href="/admin/orders/<%= order.id %>" class="btn btn-sm btn-outline-primary rounded-pill px-3">View</a>
                  </td>
                </tr>
              <% end %>
            <% else %>
              <tr>
                <td colspan="6" class="text-center text-muted py-4">No orders placed yet.</td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <% if @orders.respond_to?(:total_pages) && @orders.total_pages > 1 %>
        <div class="px-4 py-3 border-top bg-light">
          <%= paginate @orders %>
        </div>
      <% end %>
    </div>
  </div>
</div>
