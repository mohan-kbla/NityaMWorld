<%= form_with model: [:admin, coupon], local: true, class: "row g-3" do |f| %>
  <% if coupon.errors.any? %>
    <div class="col-12 alert alert-danger">
      <h6 class="alert-heading font-weight-bold"><%= pluralize(coupon.errors.count, "error") %> prohibited this coupon from being saved:</h6>
      <ul class="mb-0 small">
        <% coupon.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="col-md-6">
    <%= f.label :code, class: "form-label" %>
    <%= f.text_field :code, class: "form-control", required: true %>
  </div>

  <div class="col-md-6">
    <%= f.label :discount_type, "Discount Type", class: "form-label" %>
    <%= f.select :discount_type, [["Percentage (%)", "percentage"], ["Flat Cash (₹)", "flat"], ["Free Shipping", "free_shipping"]], {}, { class: "form-select", required: true } %>
  </div>

  <div class="col-md-4">
    <%= f.label :discount_value, "Discount Value", class: "form-label" %>
    <%= f.number_field :discount_value, step: "0.01", class: "form-control", required: true %>
  </div>

  <div class="col-md-4">
    <%= f.label :min_order_amount, "Min Order Amount (₹)", class: "form-label" %>
    <%= f.number_field :min_order_amount, step: "0.01", class: "form-control", required: true %>
  </div>

  <div class="col-md-4">
    <%= f.label :usage_limit, "Usage Limit (null for unlimited)", class: "form-label" %>
    <%= f.number_field :usage_limit, class: "form-control" %>
  </div>

  <div class="col-md-6">
    <%= f.label :expiry_date, class: "form-label" %>
    <%= f.datetime_field :expiry_date, class: "form-control" %>
  </div>

  <div class="col-md-6 d-flex align-items-end">
    <div class="form-check mb-2">
      <%= f.check_box :active, class: "form-check-input" %>
      <%= f.label :active, class: "form-check-label" %>
    </div>
  </div>

  <div class="col-12 mt-4 d-flex gap-2">
    <%= f.submit class: "btn btn-primary" %>
    <a href="/admin/coupons" class="btn btn-outline-secondary">Cancel</a>
  </div>
<% end %>
