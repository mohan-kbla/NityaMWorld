<%= form_with model: [:admin, testimonial], local: true, class: "row g-3" do |f| %>
  <% if testimonial.errors.any? %>
    <div class="col-12 alert alert-danger">
      <h6 class="alert-heading font-weight-bold"><%= pluralize(testimonial.errors.count, "error") %> prohibited this testimonial from being saved:</h6>
      <ul class="mb-0 small">
        <% testimonial.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="col-md-6">
    <%= f.label :author_name, "Author Name", class: "form-label" %>
    <%= f.text_field :author_name, class: "form-control", required: true %>
  </div>

  <div class="col-md-6">
    <%= f.label :author_designation, "Author Designation", class: "form-label" %>
    <%= f.text_field :author_designation, class: "form-control", placeholder: "e.g., Verified Buyer, CEO" %>
  </div>

  <div class="col-md-6">
    <%= f.label :rating, class: "form-label" %>
    <%= f.select :rating, [["5 Stars", 5], ["4 Stars", 4], ["3 Stars", 3], ["2 Stars", 2], ["1 Star", 1]], {}, { class: "form-select", required: true } %>
  </div>

  <div class="col-md-6">
    <%= f.label :image, "Author Photo", class: "form-label" %>
    <%= f.file_field :image, class: "form-control" %>
  </div>

  <div class="col-12">
    <%= f.label :content, "Review Content", class: "form-label" %>
    <%= f.text_area :content, rows: 4, class: "form-control", required: true %>
  </div>

  <div class="col-12">
    <div class="form-check">
      <%= f.check_box :active, class: "form-check-input" %>
      <%= f.label :active, class: "form-check-label" %>
    </div>
  </div>

  <div class="col-12 mt-4 d-flex gap-2">
    <%= f.submit class: "btn btn-primary" %>
    <a href="/admin/testimonials" class="btn btn-outline-secondary">Cancel</a>
  </div>
<% end %>
