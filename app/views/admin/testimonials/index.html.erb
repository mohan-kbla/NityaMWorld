<div class="d-flex justify-content-between align-items-center mb-4">
  <h2 class="m-0">Testimonials</h2>
  <a href="/admin/testimonials/new" class="btn btn-primary"><i class="fa-solid fa-plus me-2"></i>Add Testimonial</a>
</div>

<div class="card border-0 shadow-sm p-4">
  <div class="table-responsive">
    <table class="table table-hover align-middle">
      <thead class="table-light">
        <tr>
          <th>Author</th>
          <th>Designation</th>
          <th>Rating</th>
          <th>Content</th>
          <th>Status</th>
          <th class="text-end">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if @testimonials.any? %>
          <% @testimonials.each do |testimonial| %>
            <tr>
              <td><strong><%= testimonial.author_name %></strong></td>
              <td><%= testimonial.author_designation %></td>
              <td>
                <span class="text-warning">
                  <% testimonial.rating.times do %>
                    <i class="fa-solid fa-star small"></i>
                  <% end %>
                </span>
              </td>
              <td><%= truncate(testimonial.content, length: 80) %></td>
              <td>
                <span class="badge bg-<%= testimonial.active ? 'success' : 'danger' %>">
                  <%= testimonial.active ? "Active" : "Inactive" %>
                </span>
              </td>
              <td class="text-end">
                <div class="btn-group">
                  <a href="/admin/testimonials/<%= testimonial.id %>/edit" class="btn btn-light btn-sm text-primary"><i class="fa-solid fa-pen"></i></a>
                  <%= button_to admin_testimonial_path(testimonial), method: :delete, data: { confirm: "Are you sure?" }, class: "btn btn-light btn-sm text-danger" do %>
                    <i class="fa-solid fa-trash"></i>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        <% else %>
          <tr>
            <td colspan="6" class="text-center text-muted py-3">No testimonials found.</td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
