<div class="d-flex justify-content-between align-items-center mb-4">
  <h2 class="m-0"><%= @blog.title %></h2>
  <div>
    <a href="/admin/blogs/<%= @blog.slug %>/edit" class="btn btn-outline-primary"><i class="fa-solid fa-pen me-2"></i>Edit</a>
    <a href="/admin/blogs" class="btn btn-light"><i class="fa-solid fa-chevron-left me-2"></i>Back to Posts</a>
  </div>
</div>

<div class="card border-0 shadow-sm p-4 mb-4">
  <div class="row g-3 small text-muted mb-3 border-bottom pb-2">
    <div class="col-md-3"><strong>Status:</strong> <%= @blog.published? ? "Published" : "Draft" %></div>
    <div class="col-md-4"><strong>Published At:</strong> <%= @blog.published_at.present? ? @blog.published_at.strftime("%B %d, %Y %H:%M") : "-" %></div>
  </div>
  <div class="blog-post-content" style="white-space: pre-wrap;">
    <%= @blog.content %>
  </div>
</div>
