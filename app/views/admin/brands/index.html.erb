<div class="d-flex justify-content-between align-items-center mb-4">
  <h2 class="m-0">Brands</h2>
  <a href="/admin/brands/new" class="btn btn-primary"><i class="fa-solid fa-plus me-2"></i>Add Brand</a>
</div>

<div class="card border-0 shadow-sm p-4">
  <div class="table-responsive">
    <table class="table table-hover align-middle">
      <thead class="table-light">
        <tr>
          <th>Name</th>
          <th>Slug</th>
          <th>Description</th>
          <th class="text-end">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if @brands.any? %>
          <% @brands.each do |brand| %>
            <tr>
              <td><strong><%= brand.name %></strong></td>
              <td><code><%= brand.slug %></code></td>
              <td><%= truncate(brand.description, length: 80) %></td>
              <td class="text-end">
                <div class="btn-group">
                  <a href="/admin/brands/<%= brand.slug %>/edit" class="btn btn-light btn-sm text-primary"><i class="fa-solid fa-pen"></i></a>
                  <%= button_to admin_brand_path(brand), method: :delete, data: { confirm: "Are you sure?" }, class: "btn btn-light btn-sm text-danger" do %>
                    <i class="fa-solid fa-trash"></i>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        <% else %>
          <tr>
            <td colspan="4" class="text-center text-muted py-3">No brands found.</td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  
  <div class="mt-3">
    <%= paginate @brands %>
  </div>
</div>
