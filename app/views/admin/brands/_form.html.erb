<%= form_with model: [:admin, brand], local: true, class: "row g-3" do |f| %>
  <% if brand.errors.any? %>
    <div class="col-12 alert alert-danger">
      <h6 class="alert-heading font-weight-bold"><%= pluralize(brand.errors.count, "error") %> prohibited this brand from being saved:</h6>
      <ul class="mb-0 small">
        <% brand.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="col-12">
    <%= f.label :name, class: "form-label" %>
    <%= f.text_field :name, class: "form-control", required: true %>
  </div>

  <div class="col-12">
    <%= f.label :description, class: "form-label" %>
    <%= f.text_area :description, rows: 4, class: "form-control" %>
  </div>

  <div class="col-12">
    <%= f.label :image, "Brand Logo Image", class: "form-label" %>
    <%= f.file_field :image, class: "form-control" %>
  </div>

  <div class="col-12 mt-4 d-flex gap-2">
    <%= f.submit class: "btn btn-primary" %>
    <a href="/admin/brands" class="btn btn-outline-secondary">Cancel</a>
  </div>
<% end %>
