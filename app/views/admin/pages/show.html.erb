<div class="d-flex justify-content-between align-items-center mb-4">
  <h2 class="m-0"><%= @page.title %></h2>
  <div>
    <a href="/admin/pages/<%= @page.slug %>/edit" class="btn btn-outline-primary"><i class="fa-solid fa-pen me-2"></i>Edit</a>
    <a href="/admin/pages" class="btn btn-light"><i class="fa-solid fa-chevron-left me-2"></i>Back to Pages</a>
  </div>
</div>

<div class="card border-0 shadow-sm p-4 mb-4">
  <div class="row g-3 small text-muted mb-3 border-bottom pb-2">
    <div class="col-md-3"><strong>Status:</strong> <%= @page.active? ? "Active" : "Inactive" %></div>
    <div class="col-md-4"><strong>Last Updated:</strong> <%= @page.updated_at.strftime("%B %d, %Y") %></div>
  </div>
  <div class="page-content" style="white-space: pre-wrap;">
    <%= @page.content %>
  </div>
</div>
