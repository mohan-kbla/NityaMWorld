<div class="d-flex justify-content-between align-items-center mb-4">
  <h2 class="m-0">Pages</h2>
  <a href="/admin/pages/new" class="btn btn-primary"><i class="fa-solid fa-plus me-2"></i>Add Page</a>
</div>

<div class="card border-0 shadow-sm p-4">
  <div class="table-responsive">
    <table class="table table-hover align-middle">
      <thead class="table-light">
        <tr>
          <th>Title</th>
          <th>Slug</th>
          <th>Status</th>
          <th>Updated At</th>
          <th class="text-end">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if @pages.any? %>
          <% @pages.each do |page| %>
            <tr>
              <td><strong><%= page.title %></strong></td>
              <td><code><%= page.slug %></code></td>
              <td>
                <span class="badge bg-<%= page.active ? 'success' : 'danger' %>">
                  <%= page.active ? "Active" : "Inactive" %>
                </span>
              </td>
              <td><%= page.updated_at.strftime("%b %d, %Y") %></td>
              <td class="text-end">
                <div class="btn-group">
                  <a href="/admin/pages/<%= page.slug %>" class="btn btn-light btn-sm"><i class="fa-solid fa-eye"></i></a>
                  <a href="/admin/pages/<%= page.slug %>/edit" class="btn btn-light btn-sm text-primary"><i class="fa-solid fa-pen"></i></a>
                  <%= button_to admin_page_path(page), method: :delete, data: { confirm: "Are you sure?" }, class: "btn btn-light btn-sm text-danger" do %>
                    <i class="fa-solid fa-trash"></i>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        <% else %>
          <tr>
            <td colspan="5" class="text-center text-muted py-3">No pages created yet.</td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  
  <div class="mt-3">
    <%= paginate @pages %>
  </div>
</div>
